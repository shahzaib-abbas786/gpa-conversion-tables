  "resources": [
    {
      "name": "gpa-conversion-tables-csv",
      "path": "gpa-conversion-tables.csv",
      "title": "GPA/CGPA conversion rules (CSV)",
      "format": "csv",
      "mediatype": "text/csv",
      "encoding": "utf-8",
      "schema": {
        "fields": [
          {
            "name": "id",
            "type": "string",
            "description": "Stable rule identifier"
          },
          {
            "name": "institution",
            "type": "string",
            "description": "University/board the rule belongs to"
          },
          {
            "name": "scale",
            "type": "string",
            "description": "Input scale the formula applies to"
          },
          {
            "name": "formula",
            "type": "string",
            "description": "The conversion formula"
          },
          {
            "name": "example_input",
            "type": "any",
            "description": "Worked-example input (number, or letter grade for the ECTS-bands row)"
          },
          {
            "name": "example_output",
            "type": "any",
            "description": "Worked-example output (percentage or German grade)"
          },
          {
            "name": "output_unit",
            "type": "string",
            "description": "Unit of example_output"
          },
          {
            "name": "notes",
            "type": "string",
            "description": "Scheme/citation notes; empty where none"
          },
          {
            "name": "source_page",
            "type": "string",
            "description": "StudentKit page that documents and calculates the rule"
          }
        ]
      }
    },
    {
      "name": "gpa-conversion-tables-json",
      "path": "gpa-conversion-tables.json",
      "title": "GPA/CGPA conversion rules (JSON)",
      "format": "json",
      "mediatype": "application/json"
    }
  ]
}