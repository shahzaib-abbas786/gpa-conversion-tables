    {
      "id": "german-modified-bavarian",
      "institution": "Germany (modified Bavarian formula)",
      "scale": "percentage or points -> German grade 1.0-5.0 (1.0 best, 4.0 pass)",
      "formula": "german_grade = 1 + 3 * (Nmax - Nd) / (Nmax - Nmin)",
      "parameters": {
        "Nd": "the grade/score to convert",
        "Nmax": "best achievable score in the source system (e.g. 100 for percentage)",
        "Nmin": "minimum passing score in the source system (e.g. 50 for percentage, or 4.0 on a US GPA scale where 4.0 is best)"
      },
      "example": {
        "input_score": 86.0,
        "Nmax": 100.0,
        "Nmin": 50.0,
        "german_grade": 1.84
      },
      "source_page": "https://www.studentkit.tech/tools/gpa-conversion-tool"
    }
