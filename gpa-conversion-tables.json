    "name": "Shahzaib Abbas",
    "project": "StudentKit",
    "url": "https://www.studentkit.tech"
  },
  "notes": [
    "All formulas take a CGPA on the stated scale and return a percentage.",
    "Universities publish their own conversion rules; a generic table is never authoritative for official paperwork. Always confirm with your exam cell.",
    "Interactive calculators for every rule below: https://www.studentkit.tech/tools/cgpa-to-percentage-calculator"
  ],
  "conversions": [
    {
      "id": "cbse",
      "institution": "CBSE (India, class X/XII)",
      "scale": "10-point CGPA",
      "formula": "percentage = CGPA * 9.5",
      "example": {
        "cgpa": 8.0,
        "percentage": 76.0
      },
      "source_page": "https://www.studentkit.tech/cgpa-to-percentage/cbse"
    },
    {
      "id": "vtu",
      "institution": "VTU (Visvesvaraya Technological University)",
      "scale": "10-point CGPA",
      "formula": "percentage = (CGPA - 0.75) * 10",
      "applies_to": "CBCS scheme 2021-22 onwards (older schemes used percentage = CGPA * 10)",
      "example": {
        "cgpa": 8.0,
        "percentage": 72.5
      },
      "source_page": "https://www.studentkit.tech/cgpa-to-percentage/vtu"
    },
